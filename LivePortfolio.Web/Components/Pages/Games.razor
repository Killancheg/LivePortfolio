@page "/games"

<div class="container py-4">
    <div class="row g-3">
        @if (_isLoading)
        {
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-muted">Loading games...</div>
            </div>
        }
        else if (GamesList.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-light border mb-0">
                    No games found.
                </div>
            </div>
        }
        else
        {
            @foreach (var game in GamesList)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm">
                        <img src="@GetCoverImageUrl(game)"
                             class="card-img-top"
                             alt="@game.Title cover"
                             style="height: 220px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2"><a href="/games/@game.GameId" class="text-decoration-none">@game.Title</a></h5>

                            <div class="text-muted small mb-2">
                                Release date: @game.ReleaseDate.ToString("dd.MM.yyyy")
                            </div>

                            <p class="card-text small mb-3">
                                @GetShortDescription(game.Description)
                            </p>

                            <div class="mt-auto d-flex justify-content-end align-items-end">
                                @if (game.FinalScore.HasValue)
                                {
                                    <span class="badge bg-primary fs-6">
                                        @game.FinalScore.Value.ToString("0.0")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        No score yet
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>